# Store the populated file in Secret Manager, never Git.
PEARNLY_ENV=production
PEARNLY_ORIGIN=https://pearnly.com
PEARNLY_SERVICE_ORIGIN=https://pearnly.com
WORK_HOST=work.pearnly.com
WORK_BRIDGE_URL=https://work.pearnly.com
WORK_BRIDGE_SECRET=REPLACE_WITH_RANDOM_SECRET
WORK_MONGO_PASSWORD=REPLACE_WITH_RANDOM_URLSAFE_SECRET
WORK_MONGO_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
WORK_MAIL_URL=REPLACE_WITH_AUTHENTICATED_SMTP_URL
WORK_MAIL_FROM=Pearnly <hello@pearnly.com>
WORK_IMAGE=asia-southeast1-docker.pkg.dev/pearnly/pearnly-app/wekan@sha256:REPLACE_WITH_VERIFIED_DIGEST
