#!/bin/sh
# ╔══════════════════════════════════════════════════════════════════════╗
# ║  pre-push 机械闸 · 推送前本地守门 · 防"坏码上 master → 自动部署 → 502" ║
# ╚══════════════════════════════════════════════════════════════════════╝
#
# 为什么需要它(2026-05-30 血泪):
#   webhook 是 push 一上 master 就【立刻】自动部署 · 而 CI 是 push 之【后】才跑。
#   顺序 = 推坏码 → 秒速上线 → 生产崩(502)→ CI 几分钟后才变红(太晚)。
#   CI 只是"事后报警器" · 不是"事前闸门"。无人值守 loop 又因本机显示故障
#   读不到 gate 红 → 没读到就推 → 连崩 3 次(1 次手动 SSH 救回)。
#
# 本钩子把安全从「AI 记得看结果」改成「机器自己拦」:
#   任一守门红 → exit 1 → push 中止 → 坏码【永不】到 master → 永不部署。
#   不依赖任何人/AI 读输出 · 只认退出码 · 显示糊了也拦得住。
#
# 覆盖那 3 次翻车的【全部】根因:
#   ① AST off-by-one → SyntaxError    → `import app` 冒烟 + 全量 unittest 拦
#   ② 漏 import logging(F821/F822)   → ruff 拦
#   ③ 全量 unittest errors=N          → 全量 unittest 拦
#
# 安装:git config core.hooksPath scripts/git-hooks
#   四个窗口共用同一个 .git → 装一次 = 每个窗口每次 push 全覆盖。
#
# 只检查【本次 push 范围内改动的文件】· 不被无关的本地旧问题误伤。
# 紧急绕过(仅人工·明知故犯):git push --no-verify

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

# Windows 默认控制台是 cp874(泰语页):闸脚本打印中文会 UnicodeEncodeError → 退出码 1 →
# 明明通过的闸报假红,失败清单也印不出来(2026-07-25 复现:check_ai_smell 通过却 exit 1)。
#
# 必须是 PYTHONUTF8 而不是 PYTHONIOENCODING(2026-07-31 实测两头都会假红):
#   PYTHONIOENCODING 只管【本进程】的 stdout/stderr。测试里 subprocess.run(text=True) 读子
#   进程管道时用的是 locale 编码(本机 cp874)—— 子进程照 UTF-8 写、父进程照 cp874 读,
#   读线程 UnicodeDecodeError,proc.stderr 变成 None,test_file_crypto 当场 TypeError。
#   什么都不设则反过来:test_agent_capability_audit 的子进程打印中文进 cp874 管道,
#   UnicodeEncodeError 退 1,被当成闸真红。
#   PYTHONUTF8=1 是 UTF-8 模式,连 locale 编码一起改成 UTF-8,两个方向才对齐。
# 反证在 tests/unit/test_pre_push_hook_env.py:拿本钩子导出的环境真跑那两个模块。
export PYTHONUTF8=1
export PYTHONDONTWRITEBYTECODE=1

# Stale bytecode can win over a newer source file in a dirty development tree.
# Remove generated caches before any Python gate, then prevent this hook from
# creating another cache while it runs.
find . -type d -name '__pycache__' -prune -exec rm -rf '{}' +
find . -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete

echo "──────────────────────────────────────────────────────────"
echo "🔒 pre-push 机械闸 · 推送前本地守门(防坏码上线)"
echo "──────────────────────────────────────────────────────────"

# 本次要推的提交范围:merge-base(origin/master, HEAD)..HEAD —— 只算这条分支自己加的提交。
#
# 为什么不是 origin/master..HEAD(2026-07-31 实测改):`git diff A..B` 等价于 `git diff A B`,
# 是两棵【树】的差,不是「B 比 A 多出来的提交」。master 每往前跑一笔都会算到推送者头上,而且
# 方向是反的 —— master 删掉的行,在这个 diff 里变成本分支「新增」。停摆 10 天的
# worktree-erp-posting-profile 自己只动了 1 个 .md,两点却报 1286 个改动文件、棘轮红 19 个它
# 根本没碰过的监控文件;13 条有自有提交的本地分支,两点红 12 条,三点只红 4 条,8 条是纯误伤。
# 误伤的闸迟早被 --no-verify 绕过去,那才是真损失。
#
# 这不是把闸放松:真能 fast-forward 到 master 的 push,HEAD 必然已含 origin/master,此时
# merge-base == origin/master,三点与两点输出逐字节相同(已实测)。落后的分支本来就推不上
# master,替它算 master 的账没有意义。
if git rev-parse --verify --quiet origin/master >/dev/null 2>&1; then
  BASE="$(git merge-base origin/master HEAD 2>/dev/null)"
  # 无共同祖先(嫁接 / 孤儿分支):退回两点 · 宁可多查不可漏查
  [ -z "$BASE" ] && BASE="origin/master"
else
  BASE="HEAD~1"
fi
CHANGED="$(git diff --name-only "$BASE" HEAD 2>/dev/null)"
if [ -z "$CHANGED" ]; then
  echo "ℹ️  本次 push 无新增改动文件 · 跳过守门 · 放行"
  exit 0
fi

PY_CHANGED="$(printf '%s\n' "$CHANGED" | grep -E '\.py$' || true)"
PY_PRODUCT_CHANGED="$(printf '%s\n' "$PY_CHANGED" | grep -E '^(app\.py|db\.py|routes/|core/|services/)' || true)"
FE_CHANGED="$(printf '%s\n' "$CHANGED" | grep -E '(^src/|^static/|(^|/)(home|login)\.html$|\.(js|mjs|ts|css|html)$|^(package\.json|package-lock\.json|tsconfig\.json|vite\.config\.|eslint\.config\.)' || true)"
TS_CHANGED="$(printf '%s\n' "$CHANGED" | grep -E '\.ts$' || true)"
E2E_CHANGED="$(printf '%s\n' "$CHANGED" | grep -E '^(tests/e2e/.*\.spec\.js|tests/e2e/e2e_ledger\.json|scripts/_.*\.cjs|tests/unit/test_e2e_ledger_gate\.py)$' || true)"
# 视觉照搬闸触发面(docs/pos/12)· 2026-07-31 从 pos|inventory|purchase 三个前缀放宽到整个
# src/home/ 与 dist:闸的 MAPPINGS 管着 dashboard/history/clients/sales-report/acct-* 等 20 条
# route,旧写法对其中十几条本地完全不设防 —— dashboard 那条选择器烂了三周没人报警。push 即
# 秒上线、CI 是事后报警器,本地拦住才是真拦。代价:任何前端 push 多 21 秒。
DESIGN_CHANGED="$(printf '%s\n' "$CHANGED" | grep -E '^(static/pos/|src/home/|static/dist/|tests/visual/design/)' || true)"

fail() {
  echo ""
  echo "❌ 守门红:$1"
  echo "   坏码已被拦下 · push 中止 · 修好再推(绝不会到 master / 绝不会上线)。"
  echo "   —— 这正是机械闸的作用:不靠任何人读结果。"
  exit 1
}

# ── 测试 git 写操作闸(第一道 · 位置是死的,别往后挪)────────────
# 2026-07-31 P0:钩子自己往环境里带 GIT_DIR/GIT_INDEX_FILE,它俩盖过 subprocess 的 cwd=,
# 于是「在临时目录造 commit」的测试在下面那步「全量 unittest」里把 init/add/commit 全打进
# 了宿主仓(4838 files / -794172 · 分支上多出四笔 base/head)。所以本闸必须跑在 unittest
# 之前 —— 排在后面等于事后收尸,仓库那时已经被写坏了。
echo "▶ 测试 git 写操作闸(测试不许动当前仓库 · 造 commit 走 tests/unit/_git_sandbox.py)"
python scripts/check_test_git_writes.py --quiet \
  || fail "测试对当前仓库做了 git 写操作(见上方)· 临时仓库走 tests/unit/_git_sandbox.py 的 temp_git_repo/git,光靠 cwd= 挡不住钩子注入的 GIT_DIR"

# ── 破坏性 DB 测试闸(2026-07-31 加)────────────────────────────
# tests/integration 那 28 个模块会 `DROP TABLE IF EXISTS users, clients, ocr_history …
# CASCADE`,打的是 DATABASE_URL 指到哪就是哪。新写的 DROP 忘了接 require_disposable_db()
# 就等着下一个人照 docstring 跑一遍、把自己的开发库拆了(本机已中两次)。
echo "▶ 破坏性 DB 测试闸(DROP 真表前必须验目标库可丢弃)"
python scripts/check_destructive_db_tests.py --quiet \
  || fail "有测试会 DROP 真表却没接 require_disposable_db()(见上方)· 哨兵在 tests/integration/_helpers.py"

# ── Python 闸(改了任何 .py 才跑)──────────────────────────────
if [ -n "$PY_CHANGED" ]; then
  echo "▶ 改动含 .py · 跑 Python 守门"

  # 只对本次改动的 .py 跑 ruff/black(不被无关旧问题误伤)· 过滤掉已删除的文件
  PY_EXIST=""
  for f in $PY_CHANGED; do
    [ -f "$f" ] && PY_EXIST="$PY_EXIST $f"
  done

  if [ -n "$PY_EXIST" ]; then
    echo "  · ruff(未定义名 F821 / 漏 import F822 = 502 元凶)"
    # shellcheck disable=SC2086
    ruff check $PY_EXIST || fail "ruff(本次改动的 .py 有 lint 错)"

    # black 按【将要推送的提交内容】校验(git show HEAD:file),不查工作区文件。
    # 血泪(2026-07-05 三连红):并行窗口边推边改——推送的 commit 里是未格式化旧内容,
    # 工作区当时已 black 干净 → 钩子放行、CI 红。前端 prettier 早为同坑改成提交内容校验,同款。
    echo "  · black --check(格式 · 按待推送提交内容)"
    BLK_FAIL=0
    for f in $PY_EXIST; do
      git cat-file -e "HEAD:$f" 2>/dev/null || continue
      git show "HEAD:$f" | black --check --quiet --stdin-filename "$f" - >/dev/null 2>&1 \
        || { echo "    ✗ $f"; BLK_FAIL=1; }
    done
    [ "$BLK_FAIL" = "1" ] && fail "black 格式(待推送提交里的 .py 未格式化 · black 该文件后重新 commit 再推)"
  fi

  echo "  · import app 冒烟(catch SyntaxError / 漏 import → boot 崩 → 502)"
  python -c "import app" >/dev/null 2>&1 || fail "import app 失败(语法错 / 漏 import → 启动即崩)"

  echo "  · check_imports"
  python scripts/check_imports.py --quiet || fail "check_imports"

  # 未跟踪 import 闸(2026-06-13 加 · 补 2026-06-11 部署崩盲区):check_imports/import app
  # 都在工作树跑 · 看得见未 git add 的文件 → 本地全绿但 clean clone(=prod)缺文件 → 502。
  # 本闸对照 HEAD 跟踪集(prod 视角):import 目标工作树存在但 HEAD 没有 = 漏 add = 拦。
  echo "  · check_tracked_imports(import 的本地模块必须 git 已跟踪 · 防漏 add 上线崩)"
  # shellcheck disable=SC2086
  python scripts/check_tracked_imports.py --quiet $PY_EXIST \
    || fail "未跟踪 import:某 .py import 了工作树存在但未 git add 的本地模块(clean clone/prod 会 ModuleNotFoundError) · git add 该文件一并提交,或删掉 import"

  echo "  · check_i18n(home.js 4 语完整)"
  python scripts/check_i18n.py --strict --quiet || fail "check_i18n(4 语缺翻译)"

  # check_i18n 是横向比(有 zh 没 th);四语一起缺没有参照物,它看不见 —— 那种缺法用户
  # 看到的是裸键名。本闸是纵向查:源码用到的键,词典里必须存在。/home 那半边由下面前端块的
  # check_home_i18n_refs 更深地扫一遍(它还认 data-i18n 属性与常量键表),这里留的是 POS 那片。
  echo "  · check_i18n_refs(源码取词的键必须在词典里 · 四语一起缺也拦得住)"
  python scripts/check_i18n_refs.py >/dev/null \
    || { python scripts/check_i18n_refs.py | tail -20; fail "check_i18n_refs(有键在词典里查不到 · 屏上会印裸键名)"; }

  # 影响面引擎只裁剪「纯 unit 测试文件变更」:它不改变生产依赖,可安全只跑点名模块。
  # 任何生产 Python 变更仍由 impact.py 回退到分片全量,不靠不完整的 import 反查冒险漏测。
  # 子进程里的 GIT_* 由 impact.py 清掉,防测试造临时仓时把 init/add/commit 写回宿主仓。
  echo "  · impact.py unit 影响面(测试-only 变更跑子集 · 生产 Python 仍全量分片)"
  python scripts/impact.py --base "$BASE" --head HEAD --run-unit \
    || fail "impact.py 规划的 unit 测试红"

  echo "  · 新债 diff 闸(禁新增 ensure_*/巨石路由 · 铁律 #5/#17)"
  python scripts/check_new_debt.py || fail "新债 diff 闸(新增 ensure_* 或 app.py 巨石路由)"
fi

if [ -n "$E2E_CHANGED" ] && [ -z "$PY_CHANGED" ]; then
  echo "▶ E2E 影响面台账(所有 spec 必须登记 covers/only_e2e)"
  python -m unittest tests.unit.test_e2e_ledger_gate \
    || fail "E2E 影响面台账红(新增/改动 spec 未登记或 covers 失效)"
fi

# ── 前端闸(改了 js/css/html/json 才跑)────────────────────────
if [ -n "$FE_CHANGED" ]; then
  echo "▶ 改动含前端 · 跑前端守门"

  # prettier 只对【本次 push 范围内改动的前端文件】跑 · 且按【将要推送的提交内容】
  # (git show HEAD:file)校验,而非工作区文件。
  # 原因(2026-05-30 修):仓库级 `npm run format:check` 在 Windows 上会误伤——
  #   core.autocrlf=true 把 LF 检出成 CRLF · prettier endOfLine:lf 对未改动文件全报红 ·
  #   卡死所有含前端的 push(连别窗口干净的 .py/.yml commit 也被同分支挡住)。
  #   按提交内容校验 = 看真正要上 master 的字节(LF)· 不受本机 CRLF 检出影响。
  # 与 Python 闸同范式(只查本次改动)· 仓库级 format:check 仍由 CI 事后兜底。
  echo "  · prettier --check(本次改动前端文件 · 按提交内容 · 巨石经 .prettierignore 豁免)"
  FE_FMT_FAIL=0
  for f in $FE_CHANGED; do
    git cat-file -e "HEAD:$f" 2>/dev/null || continue  # 已删文件跳过
    git show "HEAD:$f" | npx prettier --check --stdin-filepath="$f" >/dev/null 2>&1 \
      || { echo "    ✗ $f"; FE_FMT_FAIL=1; }
  done
  [ "$FE_FMT_FAIL" = "1" ] && fail "prettier 格式(本次改动前端文件)"

  echo "  · eslint(前端真 bug · 0 error 放行)"
  npm run lint || fail "eslint"

  # 去 AI 味闸(守门第 7 道 · 只查本次改动的 src JS)· 2026-06-01 加:
  # 前 6 道全机械但无一查 AI 味 → 自动 loop 漏过(注释塞 emoji 照样绿)。本闸把它也机械化。
  echo "  · check_ai_smell(注释 emoji / console.log 调试残留 · 去 AI 味)"
  # shellcheck disable=SC2086
  python scripts/check_ai_smell.py $FE_CHANGED || fail "check_ai_smell(源码有 AI 味:注释 emoji / console.log)"

  # /ai 词典引用闸(2026-07-30 加)· check_i18n 只看 static/i18n-data.js,static/ai 那套
  # 独立词典没人管 → at('intake_failed_batch_n') 落空,标识符原样印在 402 卡上。
  echo "  · check_ai_i18n_refs(/ai 取词的键必须在某份词典分片里有定义)"
  python scripts/check_ai_i18n_refs.py \
    || fail "/ai 词典引用闸(见上方:这个键没定义 · at() 会把 key 原样印到页面上)"

  # /home 词典引用闸(2026-07-31 加)· 同一个洞的另一棵树,还大 3 倍(3354 处引用)。
  echo "  · check_home_i18n_refs(/home 取词的键必须在 window.I18N 里有定义)"
  python scripts/check_home_i18n_refs.py \
    || fail "/home 词典引用闸(见上方:这个键没定义 · 界面要么印 key 要么永远不翻译)"

  # TS 类型检查(C5 · .ts 的等价 node --check)· 只在改了 .ts 时跑
  if [ -n "$TS_CHANGED" ]; then
    echo "  · tsc --noEmit(TypeScript 类型检查)"
    npm run typecheck >/dev/null 2>&1 || fail "tsc 类型检查(.ts 有类型错)"
  fi

  echo "  · vite build(catch 配置/模块坏)"
  npm run build >/dev/null 2>&1 || fail "vite build 失败"

  echo "  · 打包一致性(dist 必须 == 源的最新 build)"
  # 排除 main.js* : vite 产物(有自己的 test-f)· sourcemap 含路径/时间戳跨 build 有 drift。
  # 用长格式 :(exclude):git 2.54+ 对短 :! 排除「不存在的路径」(sourcemap:false 故无 .map)会 fatal。
  git diff --quiet static/dist/ ':(exclude)static/dist/main.js' ':(exclude)static/dist/main.js.map' \
    || fail "改了前端源但 dist 没重新打包 · 跑 npm run build 后 git add static/dist 一起提交(否则 prod 跑旧 bundle · 改动不生效)"

  echo "  · check_asset_bundling(源页只引 bundle · 新资产须进打包清单)"
  python scripts/check_asset_bundling.py || fail "前端打包闸(见上方:源页明文引用=view-source 退化 / 资产漏进打包清单=样式丢)"

  # UI 设计 lint 棘轮闸(2026-06-10 · punch list 收官后挂)· 各类违规命中数只许降不许升
  # 存量(POS/admin 独立 SPA · i18n 文字强调等)在 scripts/ui_lint_baseline.json;
  # 命中下降后跑 node scripts/ui_design_lint.mjs --update-baseline 收紧。
  echo "  · ui_design_lint --gate(设计违规棘轮 · 新增旧蓝/emoji图标/自曝文案等 = 拦)"
  node scripts/ui_design_lint.mjs --gate >/dev/null 2>&1 \
    || { node scripts/ui_design_lint.mjs --gate | tail -15; fail "UI 设计 lint 棘轮(新增违规超 baseline · 看上方类别)"; }

  # 视觉照搬闸(docs/pos/12)· 改了 POS/库存/采购照搬稿页才跑 · 关键令牌必 == 设计快照
  if [ -n "$DESIGN_CHANGED" ]; then
    echo "  · 视觉照搬闸(关键令牌 getComputedStyle == 设计稿 · docs/pos/12)"
    node tests/visual/test_design_fidelity.spec.js \
      || fail "视觉照搬闸:关键令牌(主色/圆角/阴影/字号/对齐)不等设计稿 · 回去逐令牌对齐 tests/visual/design/*.html"
  fi
fi

# ── 防屎山闸(任何改动都跑 · 铁律 #27 · 整顿收官后切硬门)──────
# 整顿前这两道在 CI 是 warning 模式(怕误红拆分中的 split commit);整顿收官后
# 全文件 <500 · 在此切成本地硬拦:文件超 500 / 监控文件行数净增 → push 中止。
echo "▶ 防屎山闸(文件 ≤500 行 + 行数棘轮只降不升)"
# 2026-08-01 扩面:static/ai/**/*.js 进监控(/ai 是独立 SPA · 不走 vite · 此前整片在闸外 ·
# 收进来当场 7 个越线)。存量记 scripts/file_size_baseline.json,只许降不许升;基线外越线即红。
# --quiet 下仍会打「可以收紧基线」的提示 —— 钩子只用 quiet,那里不打就等于这条提示不存在。
echo "  · check_file_size(任何监控文件 >500 行 = 拦 · 先拆 · static/ai 存量走基线只降不升)"
python scripts/check_file_size.py --quiet || fail "check_file_size(有文件超 500 行 / 存量文件涨过基线 · 先拆到 <500)"

# base 跟上面算 CHANGED 用同一个(merge-base)· 别再分叉成两套范围:此前这里写死
# --base origin/master,于是「哪些文件算你改的」和「哪些文件算你加的行」用的是两个口径。
echo "  · check_line_ratchet(监控文件净增长 = 拦 · 合理增长在 commit 写 RATCHET-EXEMPT)"
python scripts/check_line_ratchet.py --base "$BASE" --head HEAD --quiet \
  || fail "check_line_ratchet(监控文件行数净增 · 拆/移到独立文件 · 或 commit 加 RATCHET-EXEMPT: <file> +<N> · <理由>)"

if [ -n "$FE_CHANGED" ]; then
